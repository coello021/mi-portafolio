---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tu Nombre · Proyectos">
  <section class="wrap" id="proyectos-page">
    <div class="sec-head">
      <h2 class="sec-title">Todos los proyectos</h2>
    </div>

    <div class="proj-grid">
      <article class="card">
        <div class="card-art">
          <svg width="130" height="96" viewBox="0 0 130 96">
            <rect x="6" y="50" width="15" height="36" fill="#3f5654" rx="2"/>
            <rect x="28" y="34" width="15" height="52" fill="#c9c0aa" rx="2"/>
            <rect x="50" y="56" width="15" height="30" fill="#a3613f" rx="2"/>
            <circle cx="94" cy="48" r="30" fill="none" stroke="#4a4640" stroke-width="1.5"/>
            <path d="M94 18 A30 30 0 0 1 122 52 L94 48 Z" fill="#3f5654"/>
            <path d="M94 48 L122 52 A30 30 0 0 1 72 72 Z" fill="#c9c0aa"/>
            <path d="M94 48 L72 72 A30 30 0 0 1 68 42 Z" fill="#a3613f"/>
            <path d="M94 48 L68 42 A30 30 0 0 1 94 18 Z" fill="#6b8c7a"/>
          </svg>
        </div>
        <h3>Análisis de Ventas</h3>
        <p>Análisis exploratorio y dashboard interactivo para identificar tendencias y oportunidades.</p>
        <div class="tags"><span class="tag">SQL</span><span class="tag">Python</span><span class="tag">Power BI</span></div>
      </article>

      <article class="card">
        <div class="card-art">
          <svg width="130" height="96" viewBox="0 0 130 96">
            <path d="M8 85V14" stroke="#4a4640" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M8 85H122" stroke="#4a4640" stroke-width="1.5" stroke-linecap="round"/>
            <polyline points="12,78 28,62 44,68 62,46 78,52 96,28 114,32" fill="none" stroke="#c9c0aa" stroke-width="2"/>
            <g fill="#c2794e">
              <circle cx="12" cy="78" r="4"/><circle cx="28" cy="62" r="4"/>
              <circle cx="44" cy="68" r="4"/><circle cx="62" cy="46" r="4"/>
              <circle cx="78" cy="52" r="4"/><circle cx="96" cy="28" r="4"/>
              <circle cx="114" cy="32" r="4"/>
            </g>
          </svg>
        </div>
        <h3>Predicción de Churn</h3>
        <p>Modelo de machine learning para predecir la rotación de clientes con alta precisión.</p>
        <div class="tags"><span class="tag">Python</span><span class="tag">Scikit-learn</span><span class="tag">Pandas</span></div>
      </article>

      <article class="card">
        <div class="card-art">
          <svg width="130" height="96" viewBox="0 0 130 96">
            <ellipse cx="22" cy="38" rx="14" ry="20" fill="#4f6b68"/>
            <ellipse cx="42" cy="54" rx="11" ry="16" fill="#d8c9a8"/>
            <ellipse cx="62" cy="34" rx="10" ry="18" fill="#8a5d3f"/>
            <ellipse cx="82" cy="46" rx="18" ry="22" fill="#d8c9a8" opacity=".85"/>
            <ellipse cx="104" cy="30" rx="12" ry="18" fill="#4f6b68" opacity=".8"/>
            <ellipse cx="118" cy="56" rx="9" ry="13" fill="#8a5d3f" opacity=".9"/>
          </svg>
        </div>
        <h3>Análisis de COVID-19</h3>
        <p>Visualización y análisis de datos geoespaciales sobre el impacto de la pandemia.</p>
        <div class="tags"><span class="tag">Python</span><span class="tag">Plotly</span><span class="tag">GeoPandas</span></div>
      </article>

      <!-- Cuando agregues más proyectos, copia un <article class="card">...</article> más aquí -->
    </div>
  </section>
</Layout>

<style>
  #proyectos-page{ padding:64px 0 100px; }
  .proj-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
  .card{ background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius); padding:20px; }
  .card-art{ height:130px; border-radius:6px; background:rgba(0,0,0,0.15); display:flex; align-items:center; justify-content:center; margin-bottom:16px; }
  .card h3{ font-size:17px; font-weight:600; margin-bottom:8px; }
  .card p{ color:var(--muted); font-size:13.5px; line-height:1.55; margin-bottom:16px; min-height:58px; }

  @media(max-width:860px){ .proj-grid{ grid-template-columns:1fr; } }
</style>