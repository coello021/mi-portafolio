---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tu Nombre · Portafolio">

  <!-- HERO -->
  <section id="home">
    <div class="wrap hero-inner">
      <div class="hero-box">
        <span class="corner tl"></span><span class="corner tr"></span>
        <span class="corner bl"></span><span class="corner br"></span>
        <h1>Transformo<br>datos en<br>decisiones</h1>
        <p>Analista de datos con pasión por convertir información compleja en insights claros y accionables.</p>
        <a href="/proyectos" class="btn btn-primary">
          VER PROYECTOS
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="hero-right">
        <div class="desk-strip"></div>
        <svg class="mug-wrap" viewBox="0 0 60 60" fill="none">
          <rect x="14" y="22" width="26" height="26" rx="3" fill="#23211d" stroke="#4a4640" stroke-width="2"/>
          <path d="M40 27h6a5 5 0 0 1 0 10h-6" stroke="#4a4640" stroke-width="2" fill="none"/>
          <text x="27" y="38" font-family="monospace" font-size="11" fill="#c2794e" text-anchor="middle">&lt;/&gt;</text>
        </svg>
        <div class="video-wrap">
          <video autoplay muted loop playsinline>
            <source src="/hero-video.mp4" type="video/mp4">
          </video>
        </div>
      </div>
    </div>
  </section>

  <!-- PROYECTOS DESTACADOS (carrusel) -->
  <section class="wrap" id="proyectos">
    <div class="sec-head">
      <h2 class="sec-title">Proyectos destacados</h2>
      <div class="arrows">
        <button id="prevBtn" aria-label="Anterior">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button id="nextBtn" aria-label="Siguiente">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <div class="proj-carousel" id="projCarousel">
      <article class="card">
        <div class="card-art">
          <svg width="130" height="96" viewBox="0 0 130 96">
            <rect x="6" y="50" width="15" height="36" fill="#3f5654" rx="2"/>
            <rect x="28" y="34" width="15" height="52" fill="#c9c0aa" rx="2"/>
            <rect x="50" y="56" width="15" height="30" fill="#a3613f" rx="2"/>
            <circle cx="94" cy="48" r="30" fill="none" stroke="#4a4640" stroke-width="1.5"/>
            <path d="M94 18 A30 30 0 0 1 122 52 L94 48 Z" fill="#3f5654"/>
            <path d="M94 48 L122 52 A30 30 0 0 1 72 72 Z" fill="#c9c0aa"/>
            <path d="M94 48 L72 72 A30 30 0 0 1 68 42 Z" fill="#a3613f"/>
            <path d="M94 48 L68 42 A30 30 0 0 1 94 18 Z" fill="#6b8c7a"/>
          </svg>
        </div>
        <h3>Análisis de Ventas</h3>
        <p>Análisis exploratorio y dashboard interactivo para identificar tendencias y oportunidades.</p>
        <div class="tags"><span class="tag">SQL</span><span class="tag">Python</span><span class="tag">Power BI</span></div>
      </article>

      <article class="card">
        <div class="card-art">
          <svg width="130" height="96" viewBox="0 0 130 96">
            <path d="M8 85V14" stroke="#4a4640" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M8 85H122" stroke="#4a4640" stroke-width="1.5" stroke-linecap="round"/>
            <polyline points="12,78 28,62 44,68 62,46 78,52 96,28 114,32" fill="none" stroke="#c9c0aa" stroke-width="2"/>
            <g fill="#c2794e">
              <circle cx="12" cy="78" r="4"/><circle cx="28" cy="62" r="4"/>
              <circle cx="44" cy="68" r="4"/><circle cx="62" cy="46" r="4"/>
              <circle cx="78" cy="52" r="4"/><circle cx="96" cy="28" r="4"/>
              <circle cx="114" cy="32" r="4"/>
            </g>
          </svg>
        </div>
        <h3>Predicción de Churn</h3>
        <p>Modelo de machine learning para predecir la rotación de clientes con alta precisión.</p>
        <div class="tags"><span class="tag">Python</span><span class="tag">Scikit-learn</span><span class="tag">Pandas</span></div>
      </article>

      <article class="card">
        <div class="card-art">
          <svg width="130" height="96" viewBox="0 0 130 96">
            <ellipse cx="22" cy="38" rx="14" ry="20" fill="#4f6b68"/>
            <ellipse cx="42" cy="54" rx="11" ry="16" fill="#d8c9a8"/>
            <ellipse cx="62" cy="34" rx="10" ry="18" fill="#8a5d3f"/>
            <ellipse cx="82" cy="46" rx="18" ry="22" fill="#d8c9a8" opacity=".85"/>
            <ellipse cx="104" cy="30" rx="12" ry="18" fill="#4f6b68" opacity=".8"/>
            <ellipse cx="118" cy="56" rx="9" ry="13" fill="#8a5d3f" opacity=".9"/>
          </svg>
        </div>
        <h3>Análisis de COVID-19</h3>
        <p>Visualización y análisis de datos geoespaciales sobre el impacto de la pandemia.</p>
        <div class="tags"><span class="tag">Python</span><span class="tag">Plotly</span><span class="tag">GeoPandas</span></div>
      </article>
    </div>
  </section>

  <!-- HABILIDADES -->
  <section class="wrap" id="habilidades">
    <div class="sec-head"><h2 class="sec-title">Habilidades</h2></div>
    <div class="skills-row">
      <div class="skill">
        <div class="icon">
          <svg width="46" height="46" viewBox="0 0 46 46">
            <path d="M23 4c-9.5 0-9.5 5.5-9.5 5.5v6.5h9.5v2H8.5s-5.5 0-5.5 9 4.5 9.5 4.5 9.5H12v-6.5c0-5 4-7 8.5-7h7.5c4.2 0 6.5-3 6.5-6.5v-7S35 4 23 4Z" fill="#4a8fae"/>
            <circle cx="17" cy="10" r="1.8" fill="#1b1c1b"/>
            <path d="M23 42c9.5 0 9.5-5.5 9.5-5.5V30H23v-2h14.5s5.5 0 5.5-9-4.5-9.5-4.5-9.5H34V16c0 5-4 7-8.5 7h-7.5c-4.2 0-6.5 3-6.5 6.5v7s1 5.5 11.5 5.5Z" fill="#d8b24a"/>
            <circle cx="29" cy="36" r="1.8" fill="#1b1c1b"/>
          </svg>
        </div>
        <span>PYTHON</span>
      </div>
      <div class="skill">
        <div class="icon">
          <svg width="42" height="42" viewBox="0 0 42 42">
            <ellipse cx="21" cy="9" rx="14" ry="6" fill="#9ba5a8" stroke="#606869" stroke-width="1.5"/>
            <path d="M7 9v24c0 3.3 6.3 6 14 6s14-2.7 14-6V9" fill="none" stroke="#606869" stroke-width="1.5"/>
            <path d="M7 21c0 3.3 6.3 6 14 6s14-2.7 14-6" fill="none" stroke="#606869" stroke-width="1.5"/>
          </svg>
        </div>
        <span>SQL</span>
      </div>
      <div class="skill">
        <div class="icon">
          <svg width="46" height="46" viewBox="0 0 46 46">
            <circle cx="23" cy="23" r="19" fill="#f0ebe0" stroke="#2e2c28" stroke-width="1.5"/>
            <circle cx="15" cy="15" r="5.5" fill="#2e2c28"/>
            <circle cx="31" cy="15" r="5.5" fill="#2e2c28"/>
            <circle cx="16.5" cy="16.5" r="1.8" fill="#f0ebe0"/>
            <circle cx="30.5" cy="16.5" r="1.8" fill="#f0ebe0"/>
            <ellipse cx="16.5" cy="27" rx="3.2" ry="4.5" fill="#2e2c28"/>
            <ellipse cx="29.5" cy="27" rx="3.2" ry="4.5" fill="#2e2c28"/>
            <ellipse cx="23" cy="30" rx="3.6" ry="2.8" fill="#2e2c28"/>
          </svg>
        </div>
        <span>PANDAS</span>
      </div>
      <div class="skill">
        <div class="icon">
          <svg width="46" height="46" viewBox="0 0 46 46">
            <circle cx="23" cy="23" r="19" fill="none" stroke="#4a4640" stroke-width="1.5"/>
            <g stroke-width="2.5" stroke-linecap="round">
              <line x1="23" y1="23" x2="23" y2="5" stroke="#c2794e"/>
              <line x1="23" y1="23" x2="37" y2="14" stroke="#8a8475"/>
              <line x1="23" y1="23" x2="40" y2="27" stroke="#3f5654"/>
              <line x1="23" y1="23" x2="30" y2="40" stroke="#a3613f"/>
              <line x1="23" y1="23" x2="11" y2="37" stroke="#cfc2a8"/>
              <line x1="23" y1="23" x2="6" y2="22" stroke="#6b675f"/>
              <line x1="23" y1="23" x2="10" y2="9" stroke="#3f5654"/>
            </g>
          </svg>
        </div>
        <span>MATPLOTLIB</span>
      </div>
      <div class="skill">
        <div class="icon">
          <svg width="46" height="46" viewBox="0 0 46 46">
            <g stroke="#cfc2a8" stroke-width="2.5" stroke-linecap="round">
              <line x1="10" y1="6" x2="10" y2="14"/><line x1="6" y1="10" x2="14" y2="10"/>
              <line x1="23" y1="6" x2="23" y2="14"/><line x1="19" y1="10" x2="27" y2="10"/>
              <line x1="36" y1="6" x2="36" y2="14"/><line x1="32" y1="10" x2="40" y2="10"/>
              <line x1="10" y1="21" x2="10" y2="29"/><line x1="6" y1="25" x2="14" y2="25"/>
              <line x1="23" y1="21" x2="23" y2="29"/><line x1="19" y1="25" x2="27" y2="25"/>
              <line x1="36" y1="21" x2="36" y2="29"/><line x1="32" y1="25" x2="40" y2="25"/>
              <line x1="10" y1="36" x2="10" y2="44"/><line x1="6" y1="40" x2="14" y2="40"/>
              <line x1="23" y1="36" x2="23" y2="44"/><line x1="19" y1="40" x2="27" y2="40"/>
            </g>
          </svg>
        </div>
        <span>TABLEAU</span>
      </div>
      <div class="skill">
        <div class="icon">
          <svg width="46" height="46" viewBox="0 0 46 46">
            <circle cx="19" cy="23" r="12" fill="#a3613f"/>
            <circle cx="30" cy="23" r="12" fill="none" stroke="#7a9c8e" stroke-width="2"/>
            <text x="30" y="27" font-size="7" fill="#7a9c8e" text-anchor="middle" font-weight="600">scikit</text>
          </svg>
        </div>
        <span>SCIKIT-LEARN</span>
      </div>
      <div class="skill">
        <div class="icon">
          <svg width="42" height="42" viewBox="0 0 42 42">
            <rect x="3" y="4" width="36" height="34" rx="3" fill="#3a6047"/>
            <rect x="3" y="4" width="18" height="34" rx="3" fill="#2d4e38"/>
            <text x="12" y="27" font-weight="bold" font-size="16" fill="#fff" text-anchor="middle">X</text>
            <rect x="23" y="10" width="13" height="5" fill="#254030" rx="1"/>
            <rect x="23" y="19" width="13" height="5" fill="#254030" rx="1"/>
            <rect x="23" y="28" width="13" height="5" fill="#254030" rx="1"/>
          </svg>
        </div>
        <span>EXCEL</span>
      </div>
    </div>
  </section>

  <!-- MINI RESUMEN SOBRE MÍ + CONTACTO -->
  <section class="wrap" id="resumen">
    <div class="about-grid">
      <div>
        <h2>Sobre mí</h2>
        <p>Me apasiona resolver problemas a través de los datos, desde la limpieza hasta la comunicación de insights que generan impacto.</p>
        <a href="/sobre-mi" class="btn btn-primary">
          CONOCE MÁS
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-7 8-7s8 3 8 7"/></svg>
        </a>
      </div>

      <div class="avatar">
        <img src="/cv-photo.png" alt="Foto de perfil" />
      </div>

      <div class="about-right">
        <h2>¿Trabajemos juntos?</h2>
        <p>Estoy abierto a nuevas oportunidades y proyectos desafiantes. ¡Hablemos!</p>
        <a href="/sobre-mi#contacto" class="btn btn-primary">
          CONTACTAR
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  #home{ padding:44px 0 0; }
  .hero-inner{ display:grid; grid-template-columns:0.85fr 1fr; gap:32px; align-items:center; }
  .hero-box{ position:relative; border:1px solid rgba(180,120,70,0.45); border-radius:4px; padding:38px 34px; }
  .corner{ position:absolute; width:16px; height:16px; border:2px solid var(--accent); }
  .corner.tl{ top:-2px; left:-2px; border-right:none; border-bottom:none; }
  .corner.tr{ top:-2px; right:-2px; border-left:none; border-bottom:none; }
  .corner.bl{ bottom:-2px; left:-2px; border-right:none; border-top:none; }
  .corner.br{ bottom:-2px; right:-2px; border-left:none; border-top:none; }
  .hero-box h1{ font-size:38px; line-height:1.1; font-weight:700; margin-bottom:16px; }
  .hero-box p{ color:var(--cream-dim); font-size:15px; line-height:1.65; margin-bottom:26px; max-width:340px; }

  .hero-right{ position:relative; display:flex; align-items:flex-end; justify-content:center; padding-bottom:28px; }
  .desk-strip{
    position:absolute; bottom:0; left:-36px; right:-36px; height:28px;
    background:linear-gradient(180deg, var(--wood) 0%, #3e2b1a 100%);
    border-top:2px solid #7a5438;
  }
  .mug-wrap{ position:absolute; left:0; bottom:16px; z-index:3; width:56px; }
  .video-wrap{ position:relative; z-index:2; width:100%; }
  .video-wrap video{ width:100%; display:block; }

  #proyectos, #habilidades, #resumen{ padding:80px 0; }

  .arrows{ display:flex; gap:8px; }
  .arrows button{
    width:32px; height:32px; border-radius:6px;
    border:1px solid var(--card-border); background:var(--card); color:var(--cream-dim);
    cursor:pointer; display:flex; align-items:center; justify-content:center;
  }
  .arrows button:hover{ background:var(--teal); color:var(--cream); }

  .proj-carousel{
    display:flex; gap:20px; overflow-x:auto;
    scroll-snap-type:x mandatory; scroll-behavior:smooth;
    padding-bottom:10px;
  }
  .proj-carousel::-webkit-scrollbar{ height:6px; }
  .proj-carousel::-webkit-scrollbar-thumb{ background:var(--card-border); border-radius:3px; }
  .card{
    background:var(--card); border:1px solid var(--card-border); border-radius:var(--radius);
    padding:20px; scroll-snap-align:start; flex:0 0 300px;
  }
  .card-art{ height:130px; border-radius:6px; background:rgba(0,0,0,0.15); display:flex; align-items:center; justify-content:center; margin-bottom:16px; }
  .card h3{ font-size:17px; font-weight:600; margin-bottom:8px; }
  .card p{ color:var(--muted); font-size:13.5px; line-height:1.55; margin-bottom:16px; min-height:58px; }

  .skills-row{ display:flex; gap:44px; flex-wrap:wrap; }
  .skill{ display:flex; flex-direction:column; align-items:center; gap:10px; width:82px; }
  .skill .icon{ width:50px; height:50px; display:flex; align-items:center; justify-content:center; }
  .skill span{ font-family:'Oswald',sans-serif; font-size:11px; letter-spacing:0.5px; color:var(--cream-dim); text-align:center; }

  .about-grid{ display:grid; grid-template-columns:1fr 190px 1fr; gap:28px; align-items:center; }
  .about-grid h2{ font-size:19px; font-weight:600; position:relative; padding-bottom:10px; margin-bottom:14px; }
  .about-grid h2::after{ content:""; position:absolute; left:0; bottom:0; width:34px; height:2px; background:var(--accent); }
  .about-grid p{ color:var(--cream-dim); font-size:14px; line-height:1.65; margin-bottom:20px; }
  .about-right{ text-align:right; }
  .about-right h2::after{ left:auto; right:0; }
  .about-right .btn{ float:right; }
  .avatar{
    width:170px; height:170px; border-radius:50%; margin:0 auto;
    overflow:hidden; border:3px solid var(--card-border); background:#151616;
  }
  .avatar img{ width:100%; height:100%; object-fit:cover; display:block; }

  @media(max-width:860px){
    .hero-inner{ grid-template-columns:1fr; }
    .desk-strip{ display:none; }
    .about-grid{ grid-template-columns:1fr; text-align:left; }
    .about-right{ text-align:left; }
    .about-right h2::after{ left:0; right:auto; }
    .about-right .btn{ float:none; }
  }
</style>

<script>
  const track = document.getElementById('projCarousel');
  document.getElementById('prevBtn')?.addEventListener('click', () => {
    track?.scrollBy({ left: -320, behavior: 'smooth' });
  });
  document.getElementById('nextBtn')?.addEventListener('click', () => {
    track?.scrollBy({ left: 320, behavior: 'smooth' });
  });
</script>